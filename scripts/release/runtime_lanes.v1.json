{
  "schema_version": "pados.runtime-lanes.v1",
  "targets": {
    "local-supervised-dogfood": {
      "description": "Local, supervised, single-operator, non-sensitive dogfood (the RC2 dogfood boundary). Not a production claim.",
      "required_lanes": [
        "windows-native-e2e",
        "vmware-linux-e2e",
        "windows-ci-gates",
        "vmware-linux-ci-gates",
        "postgres-integration",
        "github-ci"
      ]
    },
    "production": {
      "description": "Production readiness. Requires every runtime lane, including the external runtimes that are not validated today.",
      "required_lanes": [
        "windows-native-e2e",
        "vmware-linux-e2e",
        "windows-ci-gates",
        "vmware-linux-ci-gates",
        "postgres-integration",
        "github-ci",
        "windows-full-suite",
        "local-model-measured-execution",
        "local-model-governed-acceptance",
        "rea-runtime",
        "openmaic-runtime",
        "ai-scientist-v3-runtime"
      ]
    }
  },
  "lanes": {
    "windows-native-e2e": {
      "description": "scripts/dogfood/local_dogfood_e2e.py on Windows 11 with a private PostgreSQL cluster; evidence is E2E_RESULT.json.",
      "platform": "windows",
      "max_age_days": 14,
      "claims": [
        "LOCAL_SUPERVISED_DOGFOOD_E2E_WINDOWS"
      ],
      "does_not_cover": [
        "HARDWARE_WEBAUTHN_AUTHENTICATOR",
        "MULTI_USER",
        "NETWORK_EXPOSURE"
      ],
      "source": {
        "format": "e2e-result",
        "required_checks": [
          "postgres_ready",
          "pados_init_unique_token",
          "migrations",
          "pados_doctor",
          "serve_refuses_default_token",
          "control_auth",
          "health_live_and_ready",
          "project_create",
          "approval_required_before_route",
          "human_approval",
          "plan_visible",
          "execution_completed",
          "execution_receipt",
          "result_candidate_verified_waiting_approval",
          "broken_reference_waits_for_human_and_is_refused",
          "uncovered_step_never_runs",
          "finished_loop_cannot_be_paused_or_cancelled",
          "revoked_or_consumed_approval_authorizes_nothing",
          "restart_persistence",
          "presence_device_enrolled",
          "standing_session_cannot_decide",
          "governed_acceptance_live_cas",
          "consumed_proof_cannot_be_replayed",
          "acceptance_persists_after_restart",
          "governed_acceptance_suite"
        ]
      }
    },
    "vmware-linux-e2e": {
      "description": "The same E2E on the VMware Linux VM (virt=vmware, never WSL), from a fresh online clone.",
      "platform": "linux",
      "max_age_days": 14,
      "claims": [
        "LOCAL_SUPERVISED_DOGFOOD_E2E_LINUX"
      ],
      "does_not_cover": [
        "HARDWARE_WEBAUTHN_AUTHENTICATOR",
        "MULTI_USER",
        "NETWORK_EXPOSURE",
        "HYPERVISOR_ATTESTATION"
      ],
      "source": {
        "format": "e2e-result",
        "required_checks": [
          "postgres_ready",
          "pados_init_unique_token",
          "migrations",
          "pados_doctor",
          "serve_refuses_default_token",
          "control_auth",
          "health_live_and_ready",
          "project_create",
          "approval_required_before_route",
          "human_approval",
          "plan_visible",
          "execution_completed",
          "execution_receipt",
          "result_candidate_verified_waiting_approval",
          "broken_reference_waits_for_human_and_is_refused",
          "uncovered_step_never_runs",
          "finished_loop_cannot_be_paused_or_cancelled",
          "revoked_or_consumed_approval_authorizes_nothing",
          "restart_persistence",
          "presence_device_enrolled",
          "standing_session_cannot_decide",
          "governed_acceptance_live_cas",
          "consumed_proof_cannot_be_replayed",
          "acceptance_persists_after_restart",
          "governed_acceptance_suite"
        ]
      },
      "notes": "E2E_RESULT.json records the platform string, not the hypervisor; a WSL kernel string is refused, but VMware itself is attested only by the vm-summary of the ci-gates lane."
    },
    "windows-ci-gates": {
      "description": "The CI-required gates run natively on Windows by scripts/validation/windows_validate.py; evidence is the gate-summary-lane.json that windows_lane_records.py writes from its run. The registry fixes the complete gate list.",
      "platform": "windows",
      "max_age_days": 14,
      "claims": [
        "CI_REQUIRED_GATES_WINDOWS"
      ],
      "notes": "win_local_intel contains a pre-existing timing-sensitive test (R19-3); a run where it failed is FAIL, not PASS.",
      "source": {
        "format": "gate-summary",
        "required_checks": [
          "ci_policy",
          "ruff",
          "mypy",
          "mypy_win32",
          "compileall",
          "d1",
          "d2",
          "d4",
          "migration_gate",
          "win_native_1",
          "win_native_2",
          "win_local_intel",
          "public_export",
          "secret_scan",
          "operability_gate",
          "doc_lint",
          "frontend",
          "npm_cli"
        ]
      }
    },
    "vmware-linux-ci-gates": {
      "description": "The CI gate set on the VMware Linux VM, including the full deterministic suite with CI-provisioned databases and the wheel build.",
      "platform": "linux",
      "max_age_days": 14,
      "claims": [
        "CI_GATES_LINUX"
      ],
      "source": {
        "format": "vm-summary",
        "required_checks": [
          "ci_policy",
          "ruff",
          "mypy",
          "mypy_win32",
          "compileall",
          "migration_gate",
          "d1",
          "d2",
          "d4",
          "pack_focused",
          "full_pytest",
          "public_export",
          "secret_scan",
          "wheel_build",
          "operability_gate",
          "doc_lint",
          "frontend",
          "npm_cli_tests",
          "integration_pg"
        ]
      }
    },
    "postgres-integration": {
      "description": "scripts/release/postgres_integration_gate.py, all suites, skips refused; evidence is its postgres-integration.json (schema v1) beside the per-suite reports it hashes.",
      "platform": "any",
      "max_age_days": 14,
      "claims": [
        "POSTGRES_INTEGRATION_SUITES"
      ],
      "source": {
        "format": "postgres-gate",
        "required_checks": [
          "d1-binding",
          "d4-handoff",
          "residual",
          "proof-lane",
          "p6-11",
          "migration"
        ],
        "min_passed": {
          "d1-binding": 31,
          "d4-handoff": 18,
          "residual": 25,
          "proof-lane": 26,
          "p6-11": 7,
          "migration": 5
        },
        "suite_paths": {
          "d1-binding": [
            "tests/integration/test_rc2_approval_binding_postgres.py",
            "tests/integration/test_sec4_approval_lifecycle_postgres.py",
            "tests/integration/test_rc2_exec1_no_executor_route_postgres.py",
            "tests/integration/test_op004_idempotency_postgres.py",
            "tests/integration/test_control_work_request_capture_postgres.py"
          ],
          "d4-handoff": [
            "tests/integration/test_rc2_loop_model_handoff_postgres.py",
            "tests/integration/test_sec9_model_call_outside_transaction_postgres.py",
            "tests/integration/test_op004_lease_model_takeover_postgres.py"
          ],
          "residual": [
            "tests/integration/test_residual_plan_amendment_postgres.py",
            "tests/integration/test_op001_trace_continuity_postgres.py",
            "tests/integration/test_op004_lease_postgres.py",
            "tests/integration/test_op004_create_idempotency_postgres.py",
            "tests/integration/test_op004_db_deadline_postgres.py"
          ],
          "proof-lane": [
            "tests/integration/test_final_convergence_product_loop_postgres.py",
            "tests/integration/test_final_closure_approval_binding.py",
            "tests/integration/test_remote_live_ports.py"
          ],
          "p6-11": [
            "tests/integration/test_p6_11_controller_postgres.py",
            "tests/integration/test_p6_11_gap_postgres.py",
            "tests/integration/test_p6_11_human_gate_postgres.py",
            "tests/integration/test_p6_11_outcome_postgres.py"
          ],
          "migration": [
            "tests/integration/test_rc2_migration_0018.py",
            "tests/integration/test_final_convergence_migration_0017.py"
          ]
        }
      }
    },
    "github-ci": {
      "description": "The required GitHub check runs for the exact commit, each bound to its workflow file, job and required steps; evidence is scripts/release/collect_github_actions_evidence.py output, which keeps the check-runs, jobs, workflow-runs and annotations responses unmodified.",
      "platform": "github",
      "max_age_days": 14,
      "claims": [
        "GITHUB_REQUIRED_CHECKS"
      ],
      "source": {
        "format": "github-actions",
        "app": "github-actions",
        "app_id": 15368,
        "repository": "Jimmy0307/Pados",
        "required_checks": [
          "linux (lint, types, tests, build)",
          "windows (native suites)",
          "macos (static and contract)",
          "secret scan and CI policy",
          "dependency review",
          "codeql (python)",
          "codeql (javascript-typescript)"
        ],
        "github_checks": {
          "linux (lint, types, tests, build)": {
            "workflow": ".github/workflows/ci.yml",
            "required_steps": [
              "Ruff",
              "mypy strict",
              "D1 regression gate (approval subject binding)",
              "D4 regression gate (TaskLoop model handoff)",
              "Tests",
              "Frontend",
              "Operability contract gate"
            ]
          },
          "windows (native suites)": {
            "workflow": ".github/workflows/ci.yml",
            "required_steps": [
              "Windows-native suites",
              "D1/D2/D4 regression gates (Windows-native)"
            ]
          },
          "macos (static and contract)": {
            "workflow": ".github/workflows/ci.yml",
            "required_steps": [
              "Static and contract checks"
            ]
          },
          "secret scan and CI policy": {
            "workflow": ".github/workflows/security.yml",
            "required_steps": [
              "Repository secret scan (values are never printed)",
              "CI authority boundary policy"
            ]
          },
          "dependency review": {
            "workflow": ".github/workflows/security.yml",
            "required_steps": [
              "Dependency review",
              "Classify dependency review outcome"
            ],
            "blocker_annotation": "DEPENDENCY_REVIEW=ENVIRONMENT_BLOCKER"
          },
          "codeql (python)": {
            "workflow": ".github/workflows/security.yml",
            "required_steps": [
              "Analyze"
            ]
          },
          "codeql (javascript-typescript)": {
            "workflow": ".github/workflows/security.yml",
            "required_steps": [
              "Analyze"
            ]
          }
        }
      },
      "notes": "A dependency review that reports DEPENDENCY_REVIEW=ENVIRONMENT_BLOCKER (dependency graph disabled) concluded success without reviewing anything: the lane is NOT_VALIDATED, not PASS. The workflow identity is its path at the commit; what that file does stays with code review."
    },
    "windows-full-suite": {
      "description": "pytest tests --ignore=tests/integration on Windows.",
      "platform": "windows",
      "max_age_days": 14,
      "claims": [
        "FULL_DETERMINISTIC_SUITE_WINDOWS"
      ],
      "known_status": "FAIL",
      "notes": "R19-3: 126 environment-dependent failures that are identical on pristine main. A baseline-identical run is recorded as FAIL with its comparison, never as PASS. Evidence is a gate summary of its own (full-suite-summary.json from scripts/validation/windows_lane_records.py); the ci-gates summary cannot back two lanes.",
      "source": {
        "format": "gate-summary",
        "required_checks": [
          "full_pytest"
        ]
      }
    },
    "local-model-measured-execution": {
      "description": "Stage B M2 -> M2.1/M3 (Windows and VMware) -> M4.1 live run of the pinned qwen3:8b artifact on local Ollama.",
      "platform": "windows",
      "max_age_days": 30,
      "claims": [
        "MEASURED_LOCAL_EXECUTION_QWEN3_8B"
      ],
      "does_not_cover": [
        "MODEL_OUTPUT_TO_RESULT_CANDIDATE_OR_CAS",
        "REA_RUNTIME",
        "OPENMAIC_RUNTIME",
        "AI_SCIENTIST_V3_RUNTIME",
        "OTHER_MODELS_OR_RUNTIMES",
        "HARDWARE_ATTESTATION"
      ],
      "notes": "PR #19: proves only the bounded measured-execution path that ran (receipt, schema validation, semantic_authority NONE)."
    },
    "local-model-governed-acceptance": {
      "description": "Model output entering a ResultCandidate, human approval and the CAS.",
      "platform": "any",
      "max_age_days": 30,
      "claims": [
        "MODEL_OUTPUT_GOVERNED_ACCEPTANCE"
      ],
      "known_status": "NOT_VALIDATED",
      "notes": "R19-6: the path does not exist by design (MODEL OUTPUT != TRUTH); the measured-execution lane never satisfies it."
    },
    "rea-runtime": {
      "description": "The REA real runtime.",
      "platform": "any",
      "max_age_days": 30,
      "claims": [
        "REA_RUNTIME"
      ],
      "known_status": "NOT_VALIDATED",
      "notes": "PR #16 explicitly did not validate the real REA runtime."
    },
    "openmaic-runtime": {
      "description": "The OpenMAIC real runtime.",
      "platform": "any",
      "max_age_days": 30,
      "claims": [
        "OPENMAIC_RUNTIME"
      ],
      "known_status": "NOT_VALIDATED",
      "notes": "PR #16 explicitly did not validate the real OpenMAIC runtime."
    },
    "ai-scientist-v3-runtime": {
      "description": "The AI-Scientist-v3 governed research pack real runtime.",
      "platform": "any",
      "max_age_days": 30,
      "claims": [
        "AI_SCIENTIST_V3_RUNTIME"
      ],
      "known_status": "NOT_VALIDATED",
      "notes": "PR #17 is a draft and its real runtime is REAL_RUNTIME_NOT_VALIDATED."
    }
  }
