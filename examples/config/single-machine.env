# Single machine, Core only. Generate your own with `pados init`.
PADOS_ENV=local
PADOS_API_HOST=127.0.0.1
PADOS_API_PORT=8088
PADOS_DB_HOST=127.0.0.1
PADOS_DB_PORT=5432
PADOS_DB_USER=pados
PADOS_DB_PASSWORD=CHANGE_ME
PADOS_DB_NAME=pados_local_runtime
PADOS_OPERATIONAL_DATABASE_NAME=pados_local_runtime
PADOS_PRODUCT_DATABASE_NAME=pados_proof_runtime
PADOS_CORPUS_DATABASE_NAME=pados_corpus_runtime
PADOS_PRODUCT_WORKSPACE_ROOT=./runtime/local/workspace
PADOS_PRODUCT_OBJECT_ROOT=./runtime/local/objects
PADOS_CONTROL_API_TOKEN_HASH=REPLACE_WITH_SHA256_OF_YOUR_CONTROL_TOKEN
# Enterprise Pack disabled and no compute nodes: leave these unset.
# PADOS_ENTERPRISE_CONFIG=
# PADOS_COMPUTE_NODES_CONFIG=
